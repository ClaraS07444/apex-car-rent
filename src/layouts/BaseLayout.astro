---
import { INDEXIERUNG } from "astro:env/server";
import type { Locale } from "../i18n/locales";
import type { PageKey } from "../i18n/routes";
import { getUi, t } from "../lib/content";
import { getPageSeo } from "../lib/seo";
import { getStructuredData, serializeJsonLd } from "../lib/structured-data";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  page: PageKey;
  locale: Locale;
}

const { page, locale } = Astro.props;
// site ist in astro.config.mjs gesetzt; ohne Basis-URL wären Canonical und
// hreflang falsch, daher hart abbrechen.
const site = Astro.site;
if (!site) throw new Error("astro.config.mjs: site fehlt");
const [ui, seo, structuredData] = await Promise.all([
  getUi(),
  getPageSeo(page, locale, site),
  getStructuredData(page, locale, site),
]);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {!INDEXIERUNG && <meta name="robots" content="noindex, nofollow" />}
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    {seo.alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.hreflang}
        href={alternate.href}
      />
    ))}
    <!-- Open Graph und Twitter Card (PRD 13.1) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Apex Rent" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    {seo.canonical && <meta property="og:url" content={seo.canonical} />}
    <meta property="og:image" content={seo.og.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.og.imageAlt} />
    <meta property="og:locale" content={seo.og.locale} />
    {seo.og.localeAlternates.map((code) => (
      <meta property="og:locale:alternate" content={code} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    {structuredData.map((data) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={serializeJsonLd(data)}
      />
    ))}
    <link
      rel="preload"
      href="/fonts/manrope-300-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!--
      Reihenfolge der Kaskaden-Schichten. Steht vor allen Stylesheets, die Astro
      ans Ende des head setzt, und gilt damit unabhängig von der Bundle-Reihenfolge.
    -->
    <style is:inline>
      @layer tokens, base, layout, components, pages, utilities, motion;
    </style>
    <!--
      Markiert aktives JavaScript vor dem ersten Rendern (progressive Enhancement).
      Startet motion.ts nicht innerhalb von 2,5 s, gibt motion-fallback alle
      animierten Inhalte frei (siehe styles/motion.css).
    -->
    <script is:inline>
      document.documentElement.classList.add("js");
      setTimeout(function () {
        document.documentElement.classList.add("motion-fallback");
      }, 2500);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t(ui.skipLink, locale)}
    </a>
    <div class="header-sentinel" aria-hidden="true" data-header-sentinel></div>
    <SiteHeader page={page} locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter page={page} locale={locale} />
  </body>
</html>

<script>
  import "../scripts/motion";
</script>

<style>
  @layer components {
    /* PRD A-03: erstes fokussierbares Element, sichtbar bei Fokus */
    .skip-link {
      position: absolute;
      top: var(--space-8);
      left: var(--space-8);
      z-index: 20;
      padding: var(--space-12) var(--space-16);
      background: var(--color-white);
      color: var(--color-black);
      transform: translateY(-200%);
    }

    .skip-link:focus {
      transform: none;
    }

    /* Messpunkt für die verkleinerte Navigation nach 80px Scrollen (PRD 6) */
    .header-sentinel {
      position: absolute;
      top: 80px;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }
  }
</style>
