---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { locales, type Locale } from "../i18n/locales";
import { routes, toRouteParam, type PageKey } from "../i18n/routes";

// Alle Seiten außer den Startseiten; diese erzeugt [...lang]/index.astro.
export const getStaticPaths = (() =>
  (Object.keys(routes) as PageKey[])
    .filter((page) => page !== "home")
    .flatMap((page) =>
      locales.map((locale) => ({
        params: { path: toRouteParam(routes[page][locale]) },
        props: { page, locale },
      })),
    )) satisfies GetStaticPaths;

interface Props {
  page: PageKey;
  locale: Locale;
}

const { page, locale } = Astro.props;
---

<BaseLayout page={page} locale={locale}>
  <!-- Inhalte folgen in späteren Inkrementen (Views je Seite). -->
  <div data-page={page}></div>
</BaseLayout>
