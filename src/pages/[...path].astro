---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Contact from "../views/Contact.astro";
import Vehicles from "../views/Vehicles.astro";
import { locales, type Locale } from "../i18n/locales";
import { routes, toRouteParam, type PageKey } from "../i18n/routes";

// Alle Seiten außer den Startseiten; diese erzeugt [...lang]/index.astro.
export const getStaticPaths = (() =>
  (Object.keys(routes) as PageKey[])
    .filter((page) => page !== "home")
    .flatMap((page) =>
      locales.map((locale) => ({
        params: { path: toRouteParam(routes[page][locale]) },
        props: { page, locale },
      })),
    )) satisfies GetStaticPaths;

interface Props {
  page: PageKey;
  locale: Locale;
}

const { page, locale } = Astro.props;
---

<BaseLayout page={page} locale={locale}>
  {page === "vehicles" ? (
    <Vehicles locale={locale} />
  ) : page === "contact" ? (
    <Contact locale={locale} />
  ) : (
    // Übrige Seiten folgen in späteren Inkrementen (Rechtliches, 404)
    <div data-page={page} />
  )}
</BaseLayout>
