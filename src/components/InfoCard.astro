---
import Icon, { type IconName } from "./Icon.astro";

/**
 * Kasten in der Gegenfarbe der Section (PRD 9.1, 9.4): Ablauf, Vorteile,
 * Services, Bedingungen und Fakten. Text und CTA kommen über den Slot.
 */
interface Props {
  /** Ton des Kastens, also die Gegenfarbe der umgebenden Section */
  tone: "light" | "dark";
  title: string;
  icon?: IconName;
  /** Rote Schritt-Nummer (S2) */
  number?: number;
  /** Rote 24px-Linie über dem Titel (S3) */
  accent?: boolean;
}

const { tone, title, icon, number, accent = false } = Astro.props;
---

<article class="info-card" data-tone={tone}>
  {number !== undefined && <span class="info-card__number">{number}</span>}
  {icon && <Icon name={icon} class="info-card__icon" />}
  <h3 class:list={["info-card__title", { "info-card__title--accent": accent }]}>
    {title}
  </h3>
  <slot />
</article>

<style>
  @layer components {
    .info-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-16);
      height: 100%;
      padding: var(--space-32);
      background: var(--tone-bg);
      color: var(--tone-fg);
    }

    /* Rot als Detail; ab 24px auch auf Schwarz zulässig (PRD 9.1) */
    .info-card__number {
      font-size: var(--font-size-h2);
      line-height: 1;
      color: var(--color-red);
    }

    .info-card__title--accent::before {
      content: "";
      display: block;
      width: var(--space-24);
      height: 2px;
      margin-block-end: var(--space-16);
      background: var(--color-red);
    }

    /* CTA am unteren Rand, damit Kästen einer Reihe bündig enden */
    .info-card > :global(.button) {
      margin-block-start: auto;
      padding-inline: var(--space-16);
    }
  }
</style>
