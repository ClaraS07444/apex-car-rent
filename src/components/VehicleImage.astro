---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

/**
 * Fahrzeugbild (PRD 9.6, 10.5, T-07, P-08).
 * AVIF mit WebP-Fallback in 480 / 800 / 1200 / 1600 / 2400px, begrenzt auf
 * die Breite des Zuschnitts. width/height reservieren den Platz (kein
 * Layoutsprung); das transparente Bild zeigt beim Laden die Flächenfarbe.
 * Fällt das Bild aus, zeigt der Browser den Alt-Text mit dem Fahrzeugnamen.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  /** Darstellungsbreite je Breakpoint, z. B. "(min-width: 1024px) 85vw, 75vw" */
  sizes: string;
  /** Für das Hero-Fahrzeug: sofort und mit hoher Priorität laden */
  priority?: boolean;
  class?: string;
}

const PIPELINE_WIDTHS = [480, 800, 1200, 1600, 2400];

const { image, alt, sizes, priority = false, class: className } = Astro.props;

// Nur Breiten erzeugen, die der Zuschnitt hergibt; die größte ist das Original.
const widths = [
  ...PIPELINE_WIDTHS.filter((width) => width < image.width),
  image.width,
];
---

<Picture
  src={image}
  alt={alt}
  formats={["avif"]}
  fallbackFormat="webp"
  widths={widths}
  sizes={sizes}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding="async"
  class={className}
/>
