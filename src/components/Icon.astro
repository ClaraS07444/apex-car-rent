---
/**
 * Inline-SVG aus src/icons (Phosphor Light, MIT, PRD 9.5).
 * Ohne label ist das Icon dekorativ und für Screenreader ausgeblendet,
 * mit label bekommt es einen zugänglichen Namen (PRD A-14).
 */
const sources = import.meta.glob<string>("../icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const icons = Object.fromEntries(
  Object.entries(sources).map(([path, svg]) => [
    path.replace(/^.*\/(.+)\.svg$/, "$1"),
    svg,
  ]),
);

export type IconName =
  | "arrow-right"
  | "calendar-blank"
  | "circle-notch"
  | "clock"
  | "currency-eur"
  | "envelope-simple"
  | "gift"
  | "identification-card"
  | "instagram-logo"
  | "key"
  | "list"
  | "map-pin"
  | "phone"
  | "plus"
  | "shield-check"
  | "speedometer"
  | "star"
  | "steering-wheel"
  | "truck"
  | "warning-circle"
  | "x";

interface Props {
  name: IconName;
  label?: string;
  size?: number;
  class?: string;
}

const { name, label, size = 24, class: className } = Astro.props;

const svg = icons[name];
if (!svg) {
  throw new Error(`Icon "${name}" fehlt in src/icons.`);
}

const escapeAttr = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;");

const a11y = label
  ? `role="img" aria-label="${escapeAttr(label)}"`
  : `aria-hidden="true"`;
const classAttr = className ? ` class="${className}"` : "";
const markup = svg.replace(
  "<svg ",
  `<svg width="${size}" height="${size}" focusable="false" ${a11y}${classAttr} `,
);
---

<Fragment set:html={markup} />
