---
import Icon from "../Icon.astro";
import FieldError from "./FieldError.astro";

/** Auswahlliste (PRD 9.4) mit sichtbarem Label. */
interface Props {
  name: string;
  label: string;
  options: { value: string; label: string; selected?: boolean }[];
  required?: boolean;
}

const { name, label, options, required = false } = Astro.props;
const id = `field-${name}`;
---

<div class="field" data-field={name}>
  <label class="field__label" for={id}>
    {label}
    {required && (
      <span class="field__required" aria-hidden="true">
        {" *"}
      </span>
    )}
  </label>
  <div class="field__select">
    <select class="field__control" id={id} name={name} required={required}>
      {options.map((option) => (
        <option value={option.value} selected={option.selected}>
          {option.label}
        </option>
      ))}
    </select>
    <Icon name="arrow-right" />
  </div>
  <FieldError name={name} />
</div>
