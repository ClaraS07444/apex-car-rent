{
  "name": "apex-car-rent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-emoji.mjs src public scripts tests dist",
    "preview": "astro preview",
    "check": "astro check && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "npm run build && playwright test",
    "check:launch": "npm run build && node scripts/check-placeholders.mjs dist"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  }
}
